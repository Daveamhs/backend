# =============================================================================
# Dorisio backend — configuration template (issue #60)
# =============================================================================
# Copy to `.env` (git-ignored) and fill in real values:
#   cp .env.example .env
#
# Layering (lowest → highest):
#   1. Schema defaults        (src/config/schema.ts)
#   2. .env.development | .env.staging | .env.production   (selected by NODE_ENV)
#   3. .env and .env.local    (git-ignored)
#   4. Real process environment (docker/k8s/CI — always wins)
#
# Secret values may reference the environment or a secrets provider with
#   MY_SECRET={{ SECRET_NAME }}
# An unresolved reference aborts startup (fail fast). See docs/CONFIGURATION.md
# for the full reference of every variable below.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
# development | staging | production | test — selects the environment file
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Graceful-shutdown drain window (1000-300000 ms)
SHUTDOWN_TIMEOUT_MS=30000
# Public API host for Swagger (leave empty for localhost)
API_HOST=

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dorisio
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_LIFETIME_MS=1800000
DB_STATEMENT_TIMEOUT_MS=10000
# Log every SQL statement (development only)
DB_LOG_QUERIES=false
DB_SLOW_QUERY_THRESHOLD_MS=200
# Read-query result cache (issue #12); TTL capped at DB_QUERY_CACHE_MAX_TTL_MS
DB_QUERY_CACHE_ENABLED=true
DB_QUERY_CACHE_TTL_MS=60000
DB_QUERY_CACHE_MAX_TTL_MS=300000
DB_QUERY_CACHE_MAX_ENTRIES=1000
# Connection-leak detection and pool circuit breaker
DB_LEAK_DETECTION_TIMEOUT_MS=30000
DB_CIRCUIT_BREAKER_FAILURES=5
DB_CIRCUIT_BREAKER_RESET_MS=10000

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20
REDIS_POOL_IDLE_TIMEOUT_MS=300000
REDIS_CONNECTION_TIMEOUT_MS=30000
REDIS_HEALTHCHECK_INTERVAL_MS=60000
# In-memory fallback cache used while Redis is unreachable
CACHE_FALLBACK_MEMORY_SIZE=1000
CACHE_WARMUP_ENABLED=false
CACHE_METRICS_ENABLED=false

# ── Circuit breakers (external services, see src/lib/circuit-breaker) ───────
# Failure rate (0-1) in the rolling window that trips the circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
# Consecutive successes in HALF_OPEN before the circuit closes again
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
# Per-call timeout: slower calls are treated as failures
CIRCUIT_BREAKER_TIMEOUT_MS=60000
# How long the circuit stays OPEN before a HALF_OPEN trial call
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
# Minimum calls in the rolling window before the failure rate is evaluated
CIRCUIT_BREAKER_MIN_REQUESTS=5
# Length of the rolling window used to compute the failure rate
CIRCUIT_BREAKER_ROLLING_WINDOW_MS=60000
# Minimum call volume in the window before the circuit may trip (warm-up)
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5
# Per-integration toggles
STELLAR_CIRCUIT_BREAKER_ENABLED=true
WEBHOOK_CIRCUIT_BREAKER_ENABLED=true

# ── Background jobs ──────────────────────────────────────────────────────────
# Opt-in: the API process stays light unless explicitly told to run workers.
JOBS_WORKERS_ENABLED=false
ENABLE_WORKERS=false
JOBS_CONCURRENCY=5
JOB_DEFAULT_ATTEMPTS=3
JOB_BACKOFF_MS=1000
# BullMQ worker concurrency (src/lib/workers)
WORKER_CONCURRENCY=5

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# MUST be a strong (>= 32 char) non-placeholder value in staging/production.
JWT_SECRET=change-me-to-a-long-random-string
# Durations: number + s|m|h|d
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Error tracking (Sentry-compatible) ───────────────────────────────────────
SENTRY_DSN=
ERROR_TRACKING_ENABLED=true
# 0-1
ERROR_TRACKING_SAMPLE_RATE=1
ERROR_TRACKING_TIMEOUT_MS=5000

# ── Stellar / Soroban ────────────────────────────────────────────────────────
# testnet | mainnet | standalone
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_HORIZON_TIMEOUT_MS=60000
STELLAR_SERVER_SECRET_KEY=
USDC_CONTRACT_ID=
USDC_ISSUER=

# ── External payments ────────────────────────────────────────────────────────
# stripe | none
PAYMENTS_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# ── Domain limits ────────────────────────────────────────────────────────────
# Wallet challenge nonce lifetime (seconds)
WALLET_NONCE_EXPIRY=600
# Minimum creator payout amount (USD)
MIN_PAYOUT_AMOUNT=50

# ── Email ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
SENDGRID_API_KEY=
EMAIL_FROM=notifications@example.com

# ── HTTP surface ─────────────────────────────────────────────────────────────
# Reverse proxy trust: false | hop count | comma separated IPs/CIDRs.
# Avoid `true` — clients could forge X-Forwarded-For and evade rate limits.
TRUST_PROXY=false
# Comma separated allowlist, or * for any origin
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true
CORS_MAX_AGE=600

# ── Rate limiting (see docs/RATE_LIMITING.md) ────────────────────────────────
RATE_LIMIT_ENABLED=true
# memory = per instance; redis = shared across instances via REDIS_URL
RATE_LIMIT_STORE=memory
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=60000
RATE_LIMIT_SENSITIVE_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000

# ── GraphQL ──────────────────────────────────────────────────────────────────
GRAPHQL_ENABLED=true
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=1000

# ── Feature flags (see src/config/features.ts) ──────────────────────────────
FEATURE_EMAIL_VERIFICATION=true
FEATURE_ANALYTICS=true
FEATURE_WEBHOOKS=true
FEATURE_EXPORTS=true
FEATURE_MAINTENANCE_MODE=false
